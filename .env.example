# Firebase configuration — copy this file to .env and fill in your values
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# FCM Push Notifications — generate in Firebase Console → Cloud Messaging → Web Push certificates
VITE_FCM_VAPID_KEY=

# Sentry (error monitoring) — leave empty to disable
VITE_SENTRY_DSN=
