rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helpers globaux
    function isAuth() { return request.auth != null; }
    function isOwner(uid) { return request.auth.uid == uid; }
    
    // Récupération sécurisée du rôle (gère le fait que l'utilisateur peut ne pas exister encore)
    function userRole() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc != null ? userDoc.data.role : null;
    }
    function isAdmin() { return isAuth() && userRole() == 'admin'; }
    function isNotaire() { return isAuth() && userRole() == 'notaire'; }

    // ── USERS ──
    match /users/{uid} {
      // Lecture : tout utilisateur authentifié (nécessaire pour voir le profil des auteurs/locataires)
      allow read: if isAuth();
      
      // Création : L'utilisateur ne peut s'attribuer un rôle d'Admin lui-même
      allow create: if isOwner(uid) && request.resource.data.role != 'admin';
      
      // Modification : Le propriétaire modifie son profil mais JAMAIS son champ 'role' (seul un admin le peut)
      allow update: if isAdmin() || (isOwner(uid) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
      
      // Suppression
      allow delete: if isAdmin();

      match /favorites/{propertyId} {
        allow read, write: if isOwner(uid);
      }
      match /fcm_tokens/{tokenId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ── PROPERTIES ──
    match /properties/{propertyId} {
      // Lecture : publique
      allow read: if true;
      
      // Création : obligation d'être authentifié, d'être le owner, et le statut = 'pending'
      allow create: if isAuth() 
        && request.resource.data.owner_id == request.auth.uid
        && (isAdmin() || (request.resource.data.status == 'pending' && request.resource.data.verified_notaire == false));
      
      // Modification : 
      // - Admin / Notaire = liberté totale
      // - Propriétaire = pas le droit de modifier le statut, la certification, etc.
      allow update: if isAuth() && (
        isAdmin() || 
        isNotaire() ||
        (
          resource.data.owner_id == request.auth.uid 
          && request.resource.data.owner_id == request.auth.uid 
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'verified_notaire', 'notaire_id', 'verification_date'])
        )
      );
      
      // Suppression : Admin ou Propriétaire unique
      allow delete: if isAdmin() || (isAuth() && resource.data.owner_id == request.auth.uid);

      // Sous-col Documents Légaux
      match /documents/{docId} {
        allow read: if isAuth() && (
          get(/databases/$(database)/documents/properties/$(propertyId)).data.owner_id == request.auth.uid ||
          isNotaire() ||
          isAdmin()
        );
        allow create, update: if isAuth() && (
          get(/databases/$(database)/documents/properties/$(propertyId)).data.owner_id == request.auth.uid ||
          isNotaire() ||
          isAdmin()
        );
        allow delete: if isAuth() && (
          get(/databases/$(database)/documents/properties/$(propertyId)).data.owner_id == request.auth.uid ||
          isAdmin()
        );
      }
    }

    // ── VISITS ──
    match /visits/{visitId} {
      allow read: if isAuth() && (
        resource.data.owner_id == request.auth.uid ||
        resource.data.tenant_id == request.auth.uid ||
        isNotaire() ||
        isAdmin()
      );
      // Faille résolue : Impossible de créer une visite sous une fausse identité
      allow create: if isAuth() && request.resource.data.tenant_id == request.auth.uid;
      
      allow update: if isAuth() && (
        resource.data.owner_id == request.auth.uid ||
        resource.data.tenant_id == request.auth.uid ||
        isNotaire() ||
        isAdmin()
      );
    }

    // ── NOTIFICATIONS ──
    match /notifications/{notifId} {
      // On lit/modifie (pour isRead) uniquement ses propres notifications
      allow read, update: if isAuth() && resource.data.user_id == request.auth.uid;
      
      // N'importe qui peut créer des notifs destinées à d'autres via le système
      allow create: if isAuth();
    }

    // ── NOTAIRE CODES ──
    match /notaire_codes/{codeId} {
      allow read: if isAuth();
      allow create: if isAdmin();
      allow update: if isAuth()
        && resource.data.used == false
        && request.resource.data.used == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'used_at']);
    }

    // ── ADMIN LOGS ──
    match /admin_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuth(); // Permis globalement car le frontend génère parfois des logs
    }

    // ── SURVEYS ──
    match /surveys/{surveyId} {
      allow read: if isAuth() && (
        resource.data.user_id == request.auth.uid ||
        isAdmin()
      );
      // Impossible de soumettre un sondage au nom de quelqu'un d'autre
      allow create: if isAuth() && request.resource.data.user_id == request.auth.uid;
    }

    // ── REPORTS ──
    match /reports/{reportId} {
      allow read: if isAuth() && (
        resource.data.reporter_id == request.auth.uid ||
        isAdmin()
      );
      // Impossible de signaler au nom de quelqu'un d'autre
      allow create: if isAuth() && request.resource.data.reporter_id == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── CHATS & MESSAGES ──
    match /chats/{chatId} {
      allow read: if isAuth() && (
        resource.data.owner_id == request.auth.uid ||
        resource.data.tenant_id == request.auth.uid ||
        isAdmin() || isNotaire()
      );
      allow create: if isAuth() && (
        request.resource.data.owner_id == request.auth.uid ||
        request.resource.data.tenant_id == request.auth.uid
      );
      allow update: if isAuth() && (
        resource.data.owner_id == request.auth.uid ||
        resource.data.tenant_id == request.auth.uid ||
        isAdmin()
      );

      match /messages/{msgId} {
        allow read: if isAuth() && (
          get(/databases/$(database)/documents/chats/$(chatId)).data.owner_id == request.auth.uid ||
          get(/databases/$(database)/documents/chats/$(chatId)).data.tenant_id == request.auth.uid ||
          isAdmin() || isNotaire()
        );
        allow create: if isAuth() && (
          get(/databases/$(database)/documents/chats/$(chatId)).data.owner_id == request.auth.uid ||
          get(/databases/$(database)/documents/chats/$(chatId)).data.tenant_id == request.auth.uid
        ) && request.resource.data.sender_id == request.auth.uid;
      }
    }
  }
}
