rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helpers globaux
    function isAuth() { return request.auth != null; }
    function isOwner(uid) { return request.auth.uid == uid; }
    
    // Récupération sécurisée du rôle (gère le fait que l'utilisateur peut ne pas exister encore)
    function userRole() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc != null ? userDoc.data.role : null;
    }
    function isAdmin() { return isAuth() && userRole() == 'admin'; }
    function isNotaire() { return isAuth() && userRole() == 'notaire'; }

    // ── USERS ──
    match /users/{uid} {
      // Lecture individuelle : tout utilisateur authentifié
      allow get: if isAuth();

      // Listage : Uniquement Admin
      allow list: if isAdmin();
      
      // Création : L'utilisateur ne peut s'attribuer un rôle d'Admin lui-même
      allow create: if isOwner(uid) && request.resource.data.role != 'admin';
      
      // Modification : Le propriétaire modifie son profil mais JAMAIS son champ 'role' (seul un admin le peut)
      allow update: if isAdmin() || (isOwner(uid) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
      
      // Suppression
      allow delete: if isAdmin();

      match /favorites/{propertyId} {
        allow read, write: if isOwner(uid);
      }
      match /fcm_tokens/{tokenId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ── PROPERTIES ──
    match /properties/{propertyId} {
      // Lecture : publique
      allow read: if true;
      
      // Création : obligation d'être authentifié, d'être le owner, et le statut = 'pending'
      allow create: if isAuth() 
        && request.resource.data.owner_id == request.auth.uid
        && (isAdmin() || (request.resource.data.status == 'pending' && request.resource.data.verified_notaire == false));
      
      // Modification :
      // - Admin = liberté totale
      // - Notaire = peut modifier uniquement les biens qui lui sont assignés (notaire_id)
      // - Propriétaire = pas le droit de modifier le statut, la certification, etc.
      allow update: if isAuth() && (
        isAdmin() ||
        (isNotaire() && resource.data.notaire_id == request.auth.uid) ||
        // Prise en charge : notaire assigne son ID sur un bien sans notaire assigné
        (isNotaire()
          && (!('notaire_id' in resource.data) || resource.data.notaire_id == null || resource.data.notaire_id == '')
          && request.resource.data.notaire_id == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notaire_id', 'notaire_taken_at', 'updated_at'])) ||
        (
          resource.data.owner_id == request.auth.uid 
          && request.resource.data.owner_id == request.auth.uid 
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'verified_notaire', 'notaire_id', 'verification_date']) ||
            (resource.data.status == 'published' && request.resource.data.status in ['rented', 'sold', 'published', 'failed'])
          )
        )
      );
      
      // Suppression : Admin ou Propriétaire unique
      allow delete: if isAdmin() || (isAuth() && resource.data.owner_id == request.auth.uid);

      // Sous-col Documents Légaux
      match /documents/{docId} {
        allow read: if isAuth() && (
          get(/databases/$(database)/documents/properties/$(propertyId)).data.owner_id == request.auth.uid ||
          isNotaire() ||
          isAdmin()
        );
        allow create, update: if isAuth() && (
          get(/databases/$(database)/documents/properties/$(propertyId)).data.owner_id == request.auth.uid ||
          isNotaire() ||
          isAdmin()
        );
        allow delete: if isAuth() && (
          get(/databases/$(database)/documents/properties/$(propertyId)).data.owner_id == request.auth.uid ||
          isAdmin()
        );
      }
    }

    // ── VISITS ──
    match /visits/{visitId} {
      allow read: if isAuth() && (
        resource.data.owner_id == request.auth.uid ||
        resource.data.tenant_id == request.auth.uid ||
        isNotaire() ||
        isAdmin()
      );
      // Faille résolue : Impossible de créer une visite sous une fausse identité
      allow create: if isAuth() && request.resource.data.tenant_id == request.auth.uid;
      
      allow update: if isAuth() && (
        resource.data.owner_id == request.auth.uid ||
        resource.data.tenant_id == request.auth.uid ||
        isNotaire() ||
        isAdmin()
      );
    }

    // ── NOTIFICATIONS ──
    match /notifications/{notifId} {
      // On lit/modifie (pour isRead) uniquement ses propres notifications
      allow read, update: if isAuth() && resource.data.user_id == request.auth.uid;
      
      // N'importe qui peut créer des notifs destinées à d'autres via le système
      allow create: if isAuth();
    }

    // ── MAIL (Trigger Email Extension) ──
    match /mail/{mailId} {
      allow create: if isAuth();
    }

    // ── NOTAIRE CODES ──
    match /notaire_codes/{codeId} {
      // Lecture : Admin (listage) ou public (verification pendant signup)
      allow get: if true;
      allow list: if isAdmin() || (isAuth() && !resource.data.used); // Protège les codes valides du listage public
      allow create: if isAdmin();
      allow update: if isAuth()
        && resource.data.used == false
        && request.resource.data.used == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'used_at']);
    }

    // ── ADMIN LOGS ──
    match /admin_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuth(); // Permis globalement car le frontend génère parfois des logs
    }

    // ── SURVEYS ──
    match /surveys/{surveyId} {
      allow read: if isAuth() && (
        resource.data.user_id == request.auth.uid ||
        isAdmin()
      );
      // Impossible de soumettre un sondage au nom de quelqu'un d'autre
      allow create: if isAuth() && request.resource.data.user_id == request.auth.uid;
    }

    // ── REPORTS ──
    match /reports/{reportId} {
      allow read: if isAuth() && (
        resource.data.reporter_id == request.auth.uid ||
        isAdmin()
      );
      // Impossible de signaler au nom de quelqu'un d'autre
      allow create: if isAuth() && request.resource.data.reporter_id == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── CHATS & MESSAGES ──
    function isChatParticipant(chatId) {
      let chat = get(/databases/$(database)/documents/chats/$(chatId));
      return isAuth() && (chat.data.owner_id == request.auth.uid || chat.data.tenant_id == request.auth.uid);
    }

    match /chats/{chatId} {
      // Lecture : Participants, Admin ou Notaire
      allow read: if isAuth() && (
        resource == null || 
        resource.data.owner_id == request.auth.uid ||
        resource.data.tenant_id == request.auth.uid ||
        isAdmin() || isNotaire()
      );
      // Création : L'un des participants
      allow create: if isAuth() && (
        request.resource.data.owner_id == request.auth.uid ||
        request.resource.data.tenant_id == request.auth.uid
      );
      // Mise à jour : Participants (pour updated_at) ou Admin
      allow update: if isAuth() && (
        resource.data.owner_id == request.auth.uid ||
        resource.data.tenant_id == request.auth.uid ||
        isAdmin()
      );

      match /messages/{msgId} {
        allow read: if isChatParticipant(chatId) || isAdmin() || isNotaire();
        
        // Création : Participant + sender_id valide
        allow create: if isChatParticipant(chatId) && request.resource.data.sender_id == request.auth.uid;
        
        // Mise à jour : Autorisé uniquement pour marquer comme 'lu' par le destinataire (pas l'expéditeur)
        allow update: if isChatParticipant(chatId) 
          && resource.data.sender_id != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read == true;
      }
    }

    // ── TRANSACTIONS ──
    match /transactions/{txId} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ── BOOSTS ──
    match /boosts/{boostId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── AD BANNERS ──
    match /ad_banners/{bannerId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['impressions', 'clicks']);
    }

    // ── PROPERTY AVAILABILITIES ──
    match /property_availabilities/{propertyId} {
      // Lecture : publique (les locataires voient les créneaux disponibles)
      allow read: if true;
      // Écriture : vérifie que l'auteur est bien le propriétaire du bien référencé
      allow create, update: if isAuth() && (
        isAdmin() ||
        (request.resource.data.owner_id == request.auth.uid &&
         get(/databases/$(database)/documents/properties/$(propertyId)).data.owner_id == request.auth.uid)
      );
      allow delete: if isAdmin();
    }

    // ── DELEGATION TOKENS ──
    match /delegation_tokens/{tokenId} {
      allow read: if true;
      allow create: if isAuth() && (isNotaire() || isAdmin());
      allow update: if isAuth() && (isNotaire() || isAdmin());
    }
  }
}
