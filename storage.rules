rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helpers
    function isAuth() { return request.auth != null; }
    function getUserData() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() { return isAuth() && getUserData().role == 'admin'; }
    function isNotaire() { return isAuth() && getUserData().role == 'notaire'; }
    function isProprietaire() { return isAuth() && getUserData().role == 'proprietaire'; }

    // ── Images de propriétés : lecture publique, écriture authentifiée ──
    match /images/{allPaths=**} {
      allow read: if true;
      allow write: if isAuth()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // ── Documents légaux de propriétés (titre foncier, permis, etc.) ──
    // Lecture : uniquement par le propriétaire du bien, un notaire ou un admin
    // Écriture : Admin ou Propriétaire
    match /documents/{propertyId}/{allPaths=**} {
      allow read: if isAuth() && (
        isAdmin() || isNotaire() ||
        firestore.get(/databases/(default)/documents/properties/$(propertyId)).data.owner_id == request.auth.uid
      );
      allow write: if isAuth() && (
        isAdmin() ||
        firestore.get(/databases/(default)/documents/properties/$(propertyId)).data.owner_id == request.auth.uid
      )
      && request.resource.size < 10 * 1024 * 1024
      && (request.resource.contentType.matches('application/pdf')
          || request.resource.contentType.matches('image/.*'));
    }

    // ── Dossier Locataire (justificatifs de revenus, etc.) ──
    // SENSIBLE : uniquement le locataire lui-même, l'admin ou le PROPRIÉTAIRE (pour vérification comfort)
    match /tenant_dossiers/{userId}/{allPaths=**} {
      allow read: if isAuth() && (request.auth.uid == userId || isAdmin() || isProprietaire());
      allow write: if isAuth() && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && (request.resource.contentType.matches('application/pdf')
            || request.resource.contentType.matches('image/.*'));
    }

    // ── Pièces d'identité (CNI, passeport, etc.) ──
    match /identity/{userId}/{allPaths=**} {
      allow read: if isAuth() && (request.auth.uid == userId || isAdmin() || isProprietaire());
      allow write: if isAuth() && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && (request.resource.contentType.matches('application/pdf')
            || request.resource.contentType.matches('image/.*'));
    }

    // ── Avatars (photos de profil) : lecture publique, écriture par le propriétaire ──
    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuth() && request.auth.uid == userId
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // ── Modèles 3D : lecture publique, écriture authentifiée ──
    match /models3d/{propertyId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuth()
        && request.resource.size < 50 * 1024 * 1024
        && (request.resource.contentType.matches('model/.*')
            || request.resource.contentType.matches('application/octet-stream')
            || request.resource.contentType.matches('application/zip'));
    }

    // ── Vidéos : lecture publique, écriture authentifiée ──
    match /videos/{allPaths=**} {
      allow read: if true;
      allow write: if isAuth()
        && request.resource.size < 100 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
    }
  }
}
